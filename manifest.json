{
  "manifest_version": 3,
  "name": "Site Search",
  "short_name": "Site Search",
  "version": "0.1.0",
  "description": "Search the current website with Google directly from the address bar.",
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "ss"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
